$('#logout').onclick = () => { localStorage.removeItem('gh_token'); location.reload(); };

$('#authSwap').onclick = () => {
  mode = mode === 'register' ? 'login' : 'register';
  $('#authTitle').textContent = mode === 'register' ? 'Create your free account' : 'Sign in';
  $('#authBtn').textContent = mode === 'register' ? 'Create account' : 'Sign in';
  $('#authSwap').textContent = mode === 'register' ? 'I already have an account' : 'Create a new account';
