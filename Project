$('#send').onclick = send;
$('#input').addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey && matchMedia('(pointer:fine)').matches) { e.preventDefault(); send(); } });

const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
if (!SR) $('#mic').hidden = true;
else {
  const rec = new SR(); rec.lang = navigator.language || 'en-US';
  rec.onresult = e => { $('#input').value += (($('#input').value && ' ') + e.results[0][0].transcript); };
  rec.onend = () => $('#mic').classList.remove('on');
  rec.onerror = () => $('#mic').classList.remove('on');
  $('#mic').onclick = () => { try { rec.start(); $('#mic').classList.add('on'); } catch { rec.stop(); } };
}

function showTab(t) {
  document.querySelectorAll('.tab').forEach(b => b.classList.toggle('on', b.dataset.tab === t));
  $('#chat').hidden = t !== 'chat'; $('#image').hidden = t !== 'image';
}
document.querySelectorAll('.tab').forEach(b => b.onclick = () => showTab(b.dataset.tab));
$('#menu').onclick = () => $('#side').classList.toggle('open');

$('#gen').onclick = async () => {
