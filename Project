const $ = s => document.querySelector(s);
const token = () => localStorage.getItem('gh_token');
let convId = null, mode = 'register', attached = null, refCode = '', cfg = { daily: 20, cost: { chat: 1, image: 3 } };

async function api(path, body, method) {
  const r = await fetch('/api/' + path, {
    method: method || (body ? 'POST' : 'GET'),
    headers: { 'Content-Type': 'application/json', ...(token() && { Authorization: 'Bearer ' + token() }) },
    body: body ? JSON.stringify(body) : undefined
  });
  const j = await r.json().catch(() => ({}));
  if (r.status === 401 && token()) { localStorage.removeItem('gh_token'); location.reload(); }
  if (!r.ok) throw new Error(j.error || 'Something went wrong. Try again.');
  return j;
}

const setTheme = t => { document.documentElement.dataset.theme = t; localStorage.setItem('gh_theme', t); };
setTheme(localStorage.getItem('gh_theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark'));
document.querySelectorAll('.theme').forEach(b => b.onclick = () => setTheme(document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'));

const esc = s => s.replace(/[&<>"]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
function md(text) {
  return text.split('```').map((p, i) => {
    if (i % 2) {
      const nl = p.indexOf('\n');
      const lang = (nl < 0 ? '' : p.slice(0, nl)).trim().replace(/[^\w+-]/g, '');
      return `<div class="code"><div class="bar"><span>${lang || 'code'}</span><button class="copy">Copy</button></div><pre><code class="language-${lang}">${esc(nl < 0 ? p : p.slice(nl + 1))}</code></pre></div>`;
    }
    return esc(p).replace(/`([^`\n]+)`/g, '<code>$1</code>').replace(/\*\*([^*\n]+)\*\*/g, '<b>$1</b>').replace(/\n/g, '<br>');
  }).join('');
}

function addMsg(role, text) {
  const log = $('#log');
  log.querySelector('.starters')?.remove();
  const el = document.createElement('div');
  el.className = 'msg ' + role;
  if (role === 'assistant') el.innerHTML = md(text); else el.textContent = text;
  log.append(el);
  if (window.hljs) el.querySelectorAll('pre code').forEach(c => hljs.highlightElement(c));
  log.scrollTop = log.scrollHeight;
  return el;
}
$('#log').addEventListener('click', e => {
  if (e.target.classList.contains('copy')) {
    navigator.clipboard.writeText(e.target.closest('.code').querySelector('code').textContent);
    e.target.textContent = 'Copied';
    setTimeout(() => e.target.textContent = 'Copy', 1500);
  }
});

const STARTERS = ['Fix this error: TypeError: x is not a function', 'Make a to-do list web page with HTML, CSS and JavaScript', 'Explain what an API is, like I am new to coding', 'Write 5 short video ideas about healthy cooking'];
function newChat() {
  convId = null; clearAttach(); $('#log').textContent = '';
  const d = document.createElement('div'); d.className = 'starters';
  d.innerHTML = '<p>Try one of these, or ask anything:</p>';
  STARTERS.forEach(t => { const b = document.createElement('button'); b.textContent = t; b.onclick = () => { $('#input').value = t; $('#input').focus(); }; d.append(b); });
  $('#log').append(d); $('#side').classList.remove('open');
}
$('#newChat').onclick = () => { newChat(); loadHistory(); };

const setCredits = n => $('#credits').textContent = n + ' credits left today';

async function loadHistory() {
  const { items } = await api('conversations');
  const h = $('#hist'); h.textContent = '';
  items.forEach(c => {
    const row = document.createElement('div'); if (c.id === convId) row.className = 'on';
    const t = document.createElement('button'); t.className = 't'; t.textContent = c.title; t.onclick = () => openConv(c.id);
    const x = document.createElement('button'); x.className = 'x'; x.textContent = '×'; x.setAttribute('aria-label', 'Delete chat');
    x.onclick = async () => { await api('conversations/' + c.id, null, 'DELETE'); if (convId === c.id) newChat(); loadHistory(); };
    row.append(t, x); h.append(row);
  });
}
async function openConv(id) {
  try {
    const { messages } = await api('conversations/' + id);
    convId = id; $('#log').textContent = ''; messages.forEach(m => addMsg(m.role, m.content));
    showTab('chat'); $('#side').classList.remove('open'); loadHistory();
  } catch (e) { addMsg('error', e.message); }
}

function speak(t) {
  if (!$('#speak').checked || !('speechSynthesis' in window)) return;
  speechSynthesis.cancel();
  speechSynthesis.speak(new SpeechSynthesisUtterance(t.replace(/```[\s\S]*?```/g, ' code block. ')));
}

function clearAttach() { attached = null; $('#chip').hidden = true; $('#file').value = ''; }
$('#attach').onclick = () => $('#file').click();
$('#file').onchange = e => {
  const f = e.target.files[0]; if (!f) return;
  const rd = new FileReader();
  rd.onload = () => { attached = { name: f.name, body: String(rd.result).slice(0, 10000) }; $('#chip').textContent = 'Attached: ' + f.name + ' (first 10,000 characters). Tap + to replace.'; $('#chip').hidden = false; };
  rd.readAsText(f);
};

async function send() {
  const box = $('#input'); let text = box.value.trim();
  if (!text && !attached) return;
  const shown = text + (attached ? '\n[Attached: ' + attached.name + ']' : '');
  if (attached) text += '\n\n[File: ' + attached.name + ']\n' + attached.body;
  box.value = ''; clearAttach(); addMsg('user', shown);
  const wait = addMsg('assistant', '…'); wait.classList.add('wait'); $('#send').disabled = true;
