$('#invite').onclick = async () => {
  await navigator.clipboard.writeText(location.origin + '/?ref=' + refCode);
  $('#invite').textContent = 'Link copied'; setTimeout(() => $('#invite').textContent = 'Copy invite link (+10 credits per friend)', 1800);
};
$('#fbBtn').onclick = () => $('#fb').showModal();
$('#fbForm').addEventListener('submit', async e => {
  if (e.submitter?.value !== 'ok') return;
